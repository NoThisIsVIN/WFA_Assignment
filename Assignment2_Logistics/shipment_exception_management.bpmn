<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Defs_Shipment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:collaboration id="Collab_Defs_Shipment">
    <bpmn:participant id="Pool_Courier" name="Courier Company" processRef="shipment-process" />
    <bpmn:participant id="Pool_Shipper" name="Shipper / Customer" />
    <bpmn:participant id="Pool_Recipient" name="Recipient" />
    <bpmn:messageFlow id="Msg_Pool_Shipper_S_Booking" name="Booking" sourceRef="Pool_Shipper" targetRef="S_Booking" />
    <bpmn:messageFlow id="Msg_T_Tracking_Pool_Shipper" name="Tracking no." sourceRef="T_Tracking" targetRef="Pool_Shipper" />
    <bpmn:messageFlow id="Msg_Pool_Shipper_B_Cancel" name="Cancel" sourceRef="Pool_Shipper" targetRef="T_Transport" />
    <bpmn:messageFlow id="Msg_T_Delay_Pool_Shipper" name="New ETA" sourceRef="T_Delay" targetRef="Pool_Shipper" />
    <bpmn:messageFlow id="Msg_T_Deliver_Pool_Recipient" name="Parcel + OTP" sourceRef="T_Deliver" targetRef="Pool_Recipient" />
  </bpmn:collaboration>
  <bpmn:process id="shipment-process" name="Courier Company" isExecutable="true">
    <bpmn:laneSet id="LaneSet_shipment-process">
      <bpmn:lane id="Lane_ControlTower" name="Control Tower / Dispatcher">
        <bpmn:flowNodeRef>S_Booking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Tracking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Informed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PickupAgent" name="Pickup Agent">
        <bpmn:flowNodeRef>T_Collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Collected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_PickupFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Handover</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Hub" name="Hub / Warehouse">
        <bpmn:flowNodeRef>G_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Transport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Intl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Customs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Customs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_RTS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Returned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Customs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Lost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Delay</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Claims" name="Claims Department">
        <bpmn:flowNodeRef>M_Claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Claim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DeliveryAgent" name="Delivery Agent">
        <bpmn:flowNodeRef>M_Attempt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Delivered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Count</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Attempts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_NextDay</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="Flow_T_Claim_E_Claim" sourceRef="T_Claim" targetRef="E_Claim" />
    <bpmn:sequenceFlow id="Flow_M_Claim_T_Claim" sourceRef="M_Claim" targetRef="T_Claim" />
    <bpmn:sequenceFlow id="Flow_B_Lost_M_Claim" sourceRef="B_Lost" targetRef="M_Claim" />
    <bpmn:sequenceFlow id="Flow_T_Return_E_Returned" sourceRef="T_Return" targetRef="E_Returned" />
    <bpmn:sequenceFlow id="Flow_M_RTS_T_Return" sourceRef="M_RTS" targetRef="T_Return" />
    <bpmn:sequenceFlow id="Flow_B_Customs_M_RTS" sourceRef="B_Customs" targetRef="M_RTS" />
    <bpmn:sequenceFlow id="Flow_B_Cancel_M_RTS" sourceRef="B_Cancel" targetRef="M_RTS" />
    <bpmn:sequenceFlow id="Flow_G_Attempts_M_RTS" name="No" sourceRef="G_Attempts" targetRef="M_RTS" />
    <bpmn:sequenceFlow id="Flow_G_Attempts_C_NextDay" name="Yes" sourceRef="G_Attempts" targetRef="C_NextDay">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=attempts &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T_Count_G_Attempts" sourceRef="T_Count" targetRef="G_Attempts" />
    <bpmn:sequenceFlow id="Flow_G_Outcome_M_Claim" name="Damaged" sourceRef="G_Outcome" targetRef="M_Claim">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=deliveryOutcome = "DAMAGED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Outcome_M_RTS" name="Refused" sourceRef="G_Outcome" targetRef="M_RTS" />
    <bpmn:sequenceFlow id="Flow_G_Outcome_T_Count" name="Not home" sourceRef="G_Outcome" targetRef="T_Count">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=deliveryOutcome = "NOT_HOME"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Outcome_E_Delivered" name="Delivered" sourceRef="G_Outcome" targetRef="E_Delivered">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=deliveryOutcome = "DELIVERED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T_Deliver_G_Outcome" sourceRef="T_Deliver" targetRef="G_Outcome" />
    <bpmn:sequenceFlow id="Flow_M_Attempt_T_Deliver" sourceRef="M_Attempt" targetRef="T_Deliver" />
    <bpmn:sequenceFlow id="Flow_C_NextDay_M_Attempt" sourceRef="C_NextDay" targetRef="M_Attempt" />
    <bpmn:sequenceFlow id="Flow_M_Customs_M_Attempt" sourceRef="M_Customs" targetRef="M_Attempt" />
    <bpmn:sequenceFlow id="Flow_T_Customs_M_Customs" sourceRef="T_Customs" targetRef="M_Customs" />
    <bpmn:sequenceFlow id="Flow_G_Intl_M_Customs" name="No" sourceRef="G_Intl" targetRef="M_Customs" />
    <bpmn:sequenceFlow id="Flow_G_Intl_T_Customs" name="Yes" sourceRef="G_Intl" targetRef="T_Customs">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=international = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T_Delay_E_Informed" sourceRef="T_Delay" targetRef="E_Informed" />
    <bpmn:sequenceFlow id="Flow_B_Delay_T_Delay" sourceRef="B_Delay" targetRef="T_Delay" />
    <bpmn:sequenceFlow id="Flow_T_Transport_G_Intl" sourceRef="T_Transport" targetRef="G_Intl" />
    <bpmn:sequenceFlow id="Flow_G_Join_T_Transport" sourceRef="G_Join" targetRef="T_Transport" />
    <bpmn:sequenceFlow id="Flow_T_Tracking_G_Join" sourceRef="T_Tracking" targetRef="G_Join" />
    <bpmn:sequenceFlow id="Flow_T_Handover_G_Join" sourceRef="T_Handover" targetRef="G_Join" />
    <bpmn:sequenceFlow id="Flow_G_Split_T_Tracking" sourceRef="G_Split" targetRef="T_Tracking" />
    <bpmn:sequenceFlow id="Flow_G_Split_T_Handover" sourceRef="G_Split" targetRef="T_Handover" />
    <bpmn:sequenceFlow id="Flow_G_Collected_G_Split" name="Yes" sourceRef="G_Collected" targetRef="G_Split">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=pickupOutcome = "COLLECTED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Collected_E_PickupFailed" name="No" sourceRef="G_Collected" targetRef="E_PickupFailed" />
    <bpmn:sequenceFlow id="Flow_T_Collect_G_Collected" sourceRef="T_Collect" targetRef="G_Collected" />
    <bpmn:sequenceFlow id="Flow_G_Valid_T_Collect" name="Yes" sourceRef="G_Valid" targetRef="T_Collect">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=bookingValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Valid_E_Rejected" name="No" sourceRef="G_Valid" targetRef="E_Rejected" />
    <bpmn:sequenceFlow id="Flow_T_Validate_G_Valid" sourceRef="T_Validate" targetRef="G_Valid" />
    <bpmn:sequenceFlow id="Flow_S_Booking_T_Validate" sourceRef="S_Booking" targetRef="T_Validate" />
    <bpmn:boundaryEvent id="B_Delay" name="ETA exceeded" cancelActivity="false" attachedToRef="T_Transport">
      <bpmn:outgoing>Flow_B_Delay_T_Delay</bpmn:outgoing>
      <bpmn:timerEventDefinition id="EvDef_2">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT4H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_Lost" name="No scan for 48 h" attachedToRef="T_Transport">
      <bpmn:outgoing>Flow_B_Lost_M_Claim</bpmn:outgoing>
      <bpmn:timerEventDefinition id="EvDef_4">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_Customs" name="Held &#62; 5 days" attachedToRef="T_Customs">
      <bpmn:outgoing>Flow_B_Customs_M_RTS</bpmn:outgoing>
      <bpmn:timerEventDefinition id="EvDef_5">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:intermediateCatchEvent id="B_Cancel" name="Cancellation requested">
      <bpmn:outgoing>Flow_B_Cancel_M_RTS</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1738wtf" messageRef="Message_3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="E_Claim" name="Claim settled">
      <bpmn:incoming>Flow_T_Claim_E_Claim</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_Claim" name="Settle claim">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="settle-claim" />
        <zeebe:assignmentDefinition candidateGroups="claims" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_M_Claim_T_Claim</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Claim_E_Claim</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="M_Claim">
      <bpmn:incoming>Flow_B_Lost_M_Claim</bpmn:incoming>
      <bpmn:incoming>Flow_G_Outcome_M_Claim</bpmn:incoming>
      <bpmn:outgoing>Flow_M_Claim_T_Claim</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_Returned" name="Returned to sender">
      <bpmn:incoming>Flow_T_Return_E_Returned</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="T_Return" name="Return to shipper">
      <bpmn:incoming>Flow_M_RTS_T_Return</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Return_E_Returned</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="M_RTS">
      <bpmn:incoming>Flow_B_Cancel_M_RTS</bpmn:incoming>
      <bpmn:incoming>Flow_B_Customs_M_RTS</bpmn:incoming>
      <bpmn:incoming>Flow_G_Outcome_M_RTS</bpmn:incoming>
      <bpmn:incoming>Flow_G_Attempts_M_RTS</bpmn:incoming>
      <bpmn:outgoing>Flow_M_RTS_T_Return</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="C_NextDay" name="Next day">
      <bpmn:incoming>Flow_G_Attempts_C_NextDay</bpmn:incoming>
      <bpmn:outgoing>Flow_C_NextDay_M_Attempt</bpmn:outgoing>
      <bpmn:timerEventDefinition id="EvDef_6">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="G_Attempts" name="Attempts &#60; 3?" default="Flow_G_Attempts_M_RTS">
      <bpmn:incoming>Flow_T_Count_G_Attempts</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Attempts_C_NextDay</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Attempts_M_RTS</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="T_Count" name="Count attempt">
      <bpmn:extensionElements>
        <zeebe:script expression="=if attempts = null then 1 else attempts + 1" resultVariable="attempts" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Outcome_T_Count</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Count_G_Attempts</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="E_Delivered" name="Shipment delivered">
      <bpmn:incoming>Flow_G_Outcome_E_Delivered</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G_Outcome" name="Outcome?" default="Flow_G_Outcome_M_RTS">
      <bpmn:incoming>Flow_T_Deliver_G_Outcome</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Outcome_E_Delivered</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Outcome_T_Count</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Outcome_M_RTS</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Outcome_M_Claim</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Deliver" name="Attempt delivery">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="attempt-delivery" />
        <zeebe:assignmentDefinition candidateGroups="delivery-agents" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_M_Attempt_T_Deliver</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Deliver_G_Outcome</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="M_Attempt">
      <bpmn:incoming>Flow_M_Customs_M_Attempt</bpmn:incoming>
      <bpmn:incoming>Flow_C_NextDay_M_Attempt</bpmn:incoming>
      <bpmn:outgoing>Flow_M_Attempt_T_Deliver</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="M_Customs">
      <bpmn:incoming>Flow_G_Intl_M_Customs</bpmn:incoming>
      <bpmn:incoming>Flow_T_Customs_M_Customs</bpmn:incoming>
      <bpmn:outgoing>Flow_M_Customs_M_Attempt</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:receiveTask id="T_Customs" name="Customs clearance" messageRef="Message_4">
      <bpmn:incoming>Flow_G_Intl_T_Customs</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Customs_M_Customs</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="G_Intl" name="International?" default="Flow_G_Intl_M_Customs">
      <bpmn:incoming>Flow_T_Transport_G_Intl</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Intl_T_Customs</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Intl_M_Customs</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_Informed" name="Shipper informed">
      <bpmn:incoming>Flow_T_Delay_E_Informed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="T_Delay" name="Send delay notice">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-delay-notice" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_B_Delay_T_Delay</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Delay_E_Informed</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="T_Transport" name="Transport to destination hub" messageRef="Message_2">
      <bpmn:incoming>Flow_G_Join_T_Transport</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Transport_G_Intl</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:parallelGateway id="G_Join">
      <bpmn:incoming>Flow_T_Handover_G_Join</bpmn:incoming>
      <bpmn:incoming>Flow_T_Tracking_G_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Join_T_Transport</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="T_Tracking" name="Send tracking number">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-tracking-number" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Split_T_Tracking</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Tracking_G_Join</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:manualTask id="T_Handover" name="Hand over at hub">
      <bpmn:incoming>Flow_G_Split_T_Handover</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Handover_G_Join</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:parallelGateway id="G_Split">
      <bpmn:incoming>Flow_G_Collected_G_Split</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Split_T_Handover</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Split_T_Tracking</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="E_PickupFailed" name="Booking cancelled">
      <bpmn:incoming>Flow_G_Collected_E_PickupFailed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G_Collected" name="Collected?" default="Flow_G_Collected_E_PickupFailed">
      <bpmn:incoming>Flow_T_Collect_G_Collected</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Collected_E_PickupFailed</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Collected_G_Split</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Collect" name="Collect parcel">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="collect-parcel" />
        <zeebe:assignmentDefinition candidateGroups="pickup-agents" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Valid_T_Collect</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Collect_G_Collected</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_Rejected" name="Booking rejected">
      <bpmn:incoming>Flow_G_Valid_E_Rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G_Valid" name="Booking valid?" default="Flow_G_Valid_E_Rejected">
      <bpmn:incoming>Flow_T_Validate_G_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Valid_E_Rejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Valid_T_Collect</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="T_Validate" name="Validate booking">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="booking-validation" resultVariable="bookingValid" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S_Booking_T_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Validate_G_Valid</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:startEvent id="S_Booking" name="Booking received">
      <bpmn:outgoing>Flow_S_Booking_T_Validate</bpmn:outgoing>
      <bpmn:messageEventDefinition id="EvDef_1" messageRef="Message_1" />
    </bpmn:startEvent>
  </bpmn:process>
  <bpmn:message id="Message_1" name="Booking request" />
  <bpmn:message id="Message_2" name="Arrival scan">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=shipmentId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_3" name="Cancellation request">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=shipmentId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_4" name="Customs cleared">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=shipmentId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="Diagram_Collab_Defs_Shipment">
    <bpmndi:BPMNPlane id="Plane_Collab_Defs_Shipment" bpmnElement="Collab_Defs_Shipment">
      <bpmndi:BPMNShape id="Pool_Courier_di" bpmnElement="Pool_Courier" isHorizontal="true">
        <dc:Bounds x="160" y="210" width="3320" height="1440" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_DeliveryAgent_di" bpmnElement="Lane_DeliveryAgent" isHorizontal="true">
        <dc:Bounds x="190" y="1330" width="3290" height="320" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Claims_di" bpmnElement="Lane_Claims" isHorizontal="true">
        <dc:Bounds x="190" y="1170" width="3290" height="160" />
