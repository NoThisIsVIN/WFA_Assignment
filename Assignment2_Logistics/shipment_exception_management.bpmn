<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Defs_Shipment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:collaboration id="Collab_Defs_Shipment">
    <bpmn:participant id="Pool_Courier" name="Courier Company" processRef="shipment-process" />
    <bpmn:participant id="Pool_Shipper" name="Shipper / Customer" />
    <bpmn:participant id="Pool_Recipient" name="Recipient" />
    <bpmn:messageFlow id="Msg_Pool_Shipper_S_Booking" name="Booking request" sourceRef="Pool_Shipper" targetRef="S_Booking" />
    <bpmn:messageFlow id="Msg_T_Rejected_Pool_Shipper" name="Rejection reason" sourceRef="T_Rejected" targetRef="Pool_Shipper" />
    <bpmn:messageFlow id="Msg_T_Tracking_Pool_Shipper" name="Tracking number" sourceRef="T_Tracking" targetRef="Pool_Shipper" />
    <bpmn:messageFlow id="Msg_Pool_Shipper_B_Cancel" name="Cancel request" sourceRef="Pool_Shipper" targetRef="B_Cancel" />
    <bpmn:messageFlow id="Msg_T_DelayNotice_Pool_Shipper" name="New ETA" sourceRef="T_DelayNotice" targetRef="Pool_Shipper" />
    <bpmn:messageFlow id="Msg_T_NotifyRecipient_Pool_Recipient" name="Delivery ETA &#38; OTP" sourceRef="T_NotifyRecipient" targetRef="Pool_Recipient" />
  </bpmn:collaboration>
  <bpmn:process id="shipment-process" name="Courier Company" isExecutable="true">
    <bpmn:laneSet id="LaneSet_shipment-process">
      <bpmn:lane id="Lane_DeliveryAgent" name="Delivery Agent">
        <bpmn:flowNodeRef>T_CountDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_NotifyRecipient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Attempt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Attempts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_NextDay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Delivered</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Claims" name="Claims Department">
        <bpmn:flowNodeRef>M_Claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Cover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Covered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_PayClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_ClaimSettled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ClaimDeclined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_ClaimDeclined</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Hub" name="Hub / Warehouse">
        <bpmn:flowNodeRef>G_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Transit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Damaged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Intl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Customs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Customs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Trace</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_RTS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Returned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_Linehaul</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_NoScan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_CustomsTimeout</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PickupAgent" name="Pickup Agent">
        <bpmn:flowNodeRef>T_Collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Collected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Handover</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ControlTower" name="Control Tower / Dispatcher">
        <bpmn:flowNodeRef>S_Booking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_PayFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Schedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Pickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CountPickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_RetryPickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>X_RefundPickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Cancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Tracking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_DelayNotice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Informed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>X_RefundCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_PayComp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_PayFailed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_Booking" name="Booking received">
      <bpmn:outgoing>Flow_S_Booking_T_Validate</bpmn:outgoing>
      <bpmn:messageEventDefinition id="EvDef_1" messageRef="Message_1" />
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="T_Validate" name="Validate booking &#38; calculate charges">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="booking-validation" resultVariable="bookingResult" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S_Booking_T_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Validate_G_Valid</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="G_Valid" name="Booking valid?" default="Flow_G_Valid_T_Rejected">
      <bpmn:incoming>Flow_T_Validate_G_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Valid_T_Payment</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Valid_T_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T_Rejected" name="Notify shipper: booking rejected">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-shipper-booking-rejected" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Valid_T_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Rejected_E_Rejected</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E_Rejected" name="Booking rejected">
      <bpmn:incoming>Flow_T_Rejected_E_Rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_Payment" name="Collect payment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="collect-payment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Valid_T_Payment</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Payment_T_Schedule</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_PayFailed" name="Payment failed">
      <bpmn:incoming>Flow_B_PayFailed_E_PayFailed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_Refund" name="Refund payment" isForCompensation="true">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="refund-payment" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_Schedule" name="Schedule pickup">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="schedule-pickup" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_T_Payment_T_Schedule</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Schedule_M_Pickup</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="M_Pickup">
      <bpmn:incoming>Flow_T_Schedule_M_Pickup</bpmn:incoming>
      <bpmn:incoming>Flow_G_RetryPickup_M_Pickup</bpmn:incoming>
      <bpmn:outgoing>Flow_M_Pickup_T_Collect</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Collect" name="Collect parcel">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="collect-parcel" />
        <zeebe:assignmentDefinition candidateGroups="pickup-agents" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_M_Pickup_T_Collect</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Collect_G_Collected</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Collected" name="Parcel collected?" default="Flow_G_Collected_T_CountPickup">
      <bpmn:incoming>Flow_T_Collect_G_Collected</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Collected_T_CountPickup</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Collected_G_Split</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="T_CountPickup" name="Count failed attempt">
      <bpmn:extensionElements>
        <zeebe:script expression="=if pickupAttempts = null then 1 else pickupAttempts + 1" resultVariable="pickupAttempts" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Collected_T_CountPickup</bpmn:incoming>
      <bpmn:outgoing>Flow_T_CountPickup_G_RetryPickup</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="G_RetryPickup" name="Retry pickup?" default="Flow_G_RetryPickup_X_RefundPickup">
      <bpmn:incoming>Flow_T_CountPickup_G_RetryPickup</bpmn:incoming>
      <bpmn:outgoing>Flow_G_RetryPickup_M_Pickup</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_RetryPickup_X_RefundPickup</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="X_RefundPickup" name="Refund payment">
      <bpmn:incoming>Flow_G_RetryPickup_X_RefundPickup</bpmn:incoming>
      <bpmn:outgoing>Flow_X_RefundPickup_E_Cancelled</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="EvDef_4" activityRef="T_Payment" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="E_Cancelled" name="Booking cancelled">
      <bpmn:incoming>Flow_X_RefundPickup_E_Cancelled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="G_Split">
      <bpmn:incoming>Flow_G_Collected_G_Split</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Split_T_Handover</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Split_T_Tracking</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:manualTask id="T_Handover" name="Hand over parcel at hub">
      <bpmn:incoming>Flow_G_Split_T_Handover</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Handover_G_Join</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sendTask id="T_Tracking" name="Send tracking number">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-tracking-number" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Split_T_Tracking</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Tracking_G_Join</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="G_Join">
      <bpmn:incoming>Flow_T_Handover_G_Join</bpmn:incoming>
      <bpmn:incoming>Flow_T_Tracking_G_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Join_M_Transit</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="M_Transit">
      <bpmn:incoming>Flow_G_Join_M_Transit</bpmn:incoming>
      <bpmn:incoming>Flow_G_Found_M_Transit</bpmn:incoming>
      <bpmn:outgoing>Flow_M_Transit_T_Inspect</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Inspect" name="Sort &#38; inspect parcel">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="hub-inspection" />
        <zeebe:assignmentDefinition candidateGroups="hub-staff" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_M_Transit_T_Inspect</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Inspect_G_Damaged</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Damaged" name="Contents damaged?" default="Flow_G_Damaged_SP_Linehaul">
      <bpmn:incoming>Flow_T_Inspect_G_Damaged</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Damaged_SP_Linehaul</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Damaged_M_Claim</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="T_CountDelivery" name="Count attempt">
      <bpmn:extensionElements>
        <zeebe:script expression="=if deliveryAttempts = null then 1 else deliveryAttempts + 1" resultVariable="deliveryAttempts" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Outcome_T_CountDelivery</bpmn:incoming>
      <bpmn:outgoing>Flow_T_CountDelivery_G_Attempts</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:subProcess id="SP_Linehaul" name="Line-haul transport">
      <bpmn:incoming>Flow_G_Damaged_SP_Linehaul</bpmn:incoming>
      <bpmn:outgoing>Flow_SP_Linehaul_G_Intl</bpmn:outgoing>
      <bpmn:startEvent id="LH_S" name="Parcel ready for dispatch">
        <bpmn:outgoing>Flow_LH_S_LH_Load</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:manualTask id="LH_Load" name="Load &#38; dispatch vehicle">
        <bpmn:incoming>Flow_LH_S_LH_Load</bpmn:incoming>
        <bpmn:outgoing>Flow_LH_Load_LH_Arrived</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:intermediateCatchEvent id="LH_Arrived" name="Arrival scan at destination hub">
        <bpmn:incoming>Flow_LH_Load_LH_Arrived</bpmn:incoming>
        <bpmn:outgoing>Flow_LH_Arrived_LH_E</bpmn:outgoing>
        <bpmn:messageEventDefinition id="EvDef_5" messageRef="Message_2" />
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="LH_E" name="Arrived">
        <bpmn:incoming>Flow_LH_Arrived_LH_E</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_LH_S_LH_Load" sourceRef="LH_S" targetRef="LH_Load" />
      <bpmn:sequenceFlow id="Flow_LH_Load_LH_Arrived" sourceRef="LH_Load" targetRef="LH_Arrived" />
      <bpmn:sequenceFlow id="Flow_LH_Arrived_LH_E" sourceRef="LH_Arrived" targetRef="LH_E" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="G_Intl" name="International?" default="Flow_G_Intl_M_Customs">
      <bpmn:incoming>Flow_SP_Linehaul_G_Intl</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Intl_T_Customs</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Intl_M_Customs</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:receiveTask id="T_Customs" name="Wait for customs clearance" messageRef="Message_3">
      <bpmn:incoming>Flow_G_Intl_T_Customs</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Customs_M_Customs</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="M_Customs">
      <bpmn:incoming>Flow_G_Intl_M_Customs</bpmn:incoming>
      <bpmn:incoming>Flow_T_Customs_M_Customs</bpmn:incoming>
      <bpmn:outgoing>Flow_M_Customs_T_NotifyRecipient</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T_DelayNotice" name="Send delay notice &#38; new ETA">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-delay-notice-new-eta" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_B_Delay_T_DelayNotice</bpmn:incoming>
      <bpmn:outgoing>Flow_T_DelayNotice_E_Informed</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E_Informed" name="Shipper informed">
      <bpmn:incoming>Flow_T_DelayNotice_E_Informed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="X_RefundCancel" name="Refund payment (minus fee)">
      <bpmn:incoming>Flow_B_Cancel_X_RefundCancel</bpmn:incoming>
      <bpmn:outgoing>Flow_X_RefundCancel_M_RTS</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="EvDef_9" activityRef="T_Payment" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="T_Trace" name="Trace parcel">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="trace-parcel" />
        <zeebe:assignmentDefinition candidateGroups="hub-staff" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_B_NoScan_T_Trace</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Trace_G_Found</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Found" name="Parcel found?" default="Flow_G_Found_M_Claim">
      <bpmn:incoming>Flow_T_Trace_G_Found</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Found_M_Transit</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Found_M_Claim</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T_NotifyRecipient" name="Notify recipient">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-recipient" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_M_Customs_T_NotifyRecipient</bpmn:incoming>
      <bpmn:outgoing>Flow_T_NotifyRecipient_M_Attempt</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="M_Attempt">
      <bpmn:incoming>Flow_T_NotifyRecipient_M_Attempt</bpmn:incoming>
      <bpmn:incoming>Flow_C_NextDay_M_Attempt</bpmn:incoming>
      <bpmn:outgoing>Flow_M_Attempt_T_Deliver</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Deliver" name="Attempt delivery">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="attempt-delivery" />
        <zeebe:assignmentDefinition candidateGroups="delivery-agents" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_M_Attempt_T_Deliver</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Deliver_G_Outcome</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Outcome" name="Delivery outcome?" default="Flow_G_Outcome_M_RTS">
      <bpmn:incoming>Flow_T_Deliver_G_Outcome</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Outcome_T_Close</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Outcome_T_CountDelivery</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Outcome_M_RTS</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Outcome_M_Claim</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_Attempts" name="Attempts &#60; 3?" default="Flow_G_Attempts_M_RTS">
      <bpmn:incoming>Flow_T_CountDelivery_G_Attempts</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Attempts_C_NextDay</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Attempts_M_RTS</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="C_NextDay" name="Next working day">
      <bpmn:incoming>Flow_G_Attempts_C_NextDay</bpmn:incoming>
      <bpmn:outgoing>Flow_C_NextDay_M_Attempt</bpmn:outgoing>
      <bpmn:timerEventDefinition id="EvDef_11">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="T_Close" name="Close shipment &#38; invoice">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="close-shipment-invoice" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Outcome_T_Close</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Close_E_Delivered</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_Delivered" name="Shipment delivered">
      <bpmn:incoming>Flow_T_Close_E_Delivered</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="M_RTS">
      <bpmn:incoming>Flow_X_RefundCancel_M_RTS</bpmn:incoming>
      <bpmn:incoming>Flow_B_CustomsTimeout_M_RTS</bpmn:incoming>
      <bpmn:incoming>Flow_G_Outcome_M_RTS</bpmn:incoming>
      <bpmn:incoming>Flow_G_Attempts_M_RTS</bpmn:incoming>
      <bpmn:outgoing>Flow_M_RTS_T_Return</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="T_Return" name="Return parcel to shipper">
      <bpmn:incoming>Flow_M_RTS_T_Return</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Return_E_Returned</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="E_Returned" name="Returned to sender">
      <bpmn:incoming>Flow_T_Return_E_Returned</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="M_Claim">
      <bpmn:incoming>Flow_G_Damaged_M_Claim</bpmn:incoming>
      <bpmn:incoming>Flow_G_Found_M_Claim</bpmn:incoming>
      <bpmn:incoming>Flow_G_Outcome_M_Claim</bpmn:incoming>
      <bpmn:outgoing>Flow_M_Claim_T_Cover</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="T_Cover" name="Check insurance cover">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="claim-cover" resultVariable="claimCover" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_M_Claim_T_Cover</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Cover_G_Covered</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="G_Covered" name="Covered?" default="Flow_G_Covered_T_ClaimDeclined">
      <bpmn:incoming>Flow_T_Cover_G_Covered</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Covered_T_Assess</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Covered_T_ClaimDeclined</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Assess" name="Assess &#38; settle claim">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="assess-claim" />
        <zeebe:assignmentDefinition candidateGroups="claims-officers" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Covered_T_Assess</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Assess_T_PayClaim</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_PayClaim" name="Pay compensation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="pay-compensation" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_T_Assess_T_PayClaim</bpmn:incoming>
      <bpmn:outgoing>Flow_T_PayClaim_E_ClaimSettled</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_ClaimSettled" name="Claim settled">
      <bpmn:incoming>Flow_T_PayClaim_E_ClaimSettled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="T_ClaimDeclined" name="Inform shipper: claim declined">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="inform-shipper-claim-declined" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Covered_T_ClaimDeclined</bpmn:incoming>
      <bpmn:outgoing>Flow_T_ClaimDeclined_E_ClaimDeclined</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E_ClaimDeclined" name="Claim declined">
      <bpmn:incoming>Flow_T_ClaimDeclined_E_ClaimDeclined</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="B_NoScan" name="No scan for 48 h" attachedToRef="SP_Linehaul">
      <bpmn:outgoing>Flow_B_NoScan_T_Trace</bpmn:outgoing>
      <bpmn:timerEventDefinition id="EvDef_10">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_Cancel" name="Cancellation requested" attachedToRef="SP_Linehaul">
      <bpmn:outgoing>Flow_B_Cancel_X_RefundCancel</bpmn:outgoing>
      <bpmn:messageEventDefinition id="EvDef_8" messageRef="Message_4" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_Delay" name="ETA exceeded" cancelActivity="false" attachedToRef="SP_Linehaul">
      <bpmn:outgoing>Flow_B_Delay_T_DelayNotice</bpmn:outgoing>
      <bpmn:timerEventDefinition id="EvDef_7">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT4H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_CustomsTimeout" name="Held &#62; 5 days" attachedToRef="T_Customs">
      <bpmn:outgoing>Flow_B_CustomsTimeout_M_RTS</bpmn:outgoing>
      <bpmn:timerEventDefinition id="EvDef_6">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_PayComp" attachedToRef="T_Payment">
      <bpmn:compensateEventDefinition id="EvDef_3" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_PayFailed" name="Payment failed" attachedToRef="T_Payment">
      <bpmn:outgoing>Flow_B_PayFailed_E_PayFailed</bpmn:outgoing>
      <bpmn:errorEventDefinition id="EvDef_2" errorRef="Error_1" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_S_Booking_T_Validate" sourceRef="S_Booking" targetRef="T_Validate" />
    <bpmn:sequenceFlow id="Flow_T_Validate_G_Valid" sourceRef="T_Validate" targetRef="G_Valid" />
    <bpmn:sequenceFlow id="Flow_G_Valid_T_Payment" name="Yes" sourceRef="G_Valid" targetRef="T_Payment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=bookingResult.valid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Valid_T_Rejected" name="No" sourceRef="G_Valid" targetRef="T_Rejected" />
    <bpmn:sequenceFlow id="Flow_T_Rejected_E_Rejected" sourceRef="T_Rejected" targetRef="E_Rejected" />
    <bpmn:sequenceFlow id="Flow_T_Payment_T_Schedule" sourceRef="T_Payment" targetRef="T_Schedule" />
    <bpmn:sequenceFlow id="Flow_B_PayFailed_E_PayFailed" sourceRef="B_PayFailed" targetRef="E_PayFailed" />
    <bpmn:sequenceFlow id="Flow_T_Schedule_M_Pickup" sourceRef="T_Schedule" targetRef="M_Pickup" />
    <bpmn:sequenceFlow id="Flow_G_RetryPickup_M_Pickup" name="Yes" sourceRef="G_RetryPickup" targetRef="M_Pickup">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=pickupAttempts &lt; 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_M_Pickup_T_Collect" sourceRef="M_Pickup" targetRef="T_Collect" />
    <bpmn:sequenceFlow id="Flow_T_Collect_G_Collected" sourceRef="T_Collect" targetRef="G_Collected" />
    <bpmn:sequenceFlow id="Flow_G_Collected_T_CountPickup" name="No" sourceRef="G_Collected" targetRef="T_CountPickup" />
    <bpmn:sequenceFlow id="Flow_G_Collected_G_Split" name="Yes" sourceRef="G_Collected" targetRef="G_Split">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=pickupOutcome = "COLLECTED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T_CountPickup_G_RetryPickup" sourceRef="T_CountPickup" targetRef="G_RetryPickup" />
    <bpmn:sequenceFlow id="Flow_G_RetryPickup_X_RefundPickup" name="No" sourceRef="G_RetryPickup" targetRef="X_RefundPickup" />
    <bpmn:sequenceFlow id="Flow_X_RefundPickup_E_Cancelled" sourceRef="X_RefundPickup" targetRef="E_Cancelled" />
    <bpmn:sequenceFlow id="Flow_G_Split_T_Handover" sourceRef="G_Split" targetRef="T_Handover" />
    <bpmn:sequenceFlow id="Flow_G_Split_T_Tracking" sourceRef="G_Split" targetRef="T_Tracking" />
    <bpmn:sequenceFlow id="Flow_T_Handover_G_Join" sourceRef="T_Handover" targetRef="G_Join" />
    <bpmn:sequenceFlow id="Flow_T_Tracking_G_Join" sourceRef="T_Tracking" targetRef="G_Join" />
    <bpmn:sequenceFlow id="Flow_G_Join_M_Transit" sourceRef="G_Join" targetRef="M_Transit" />
    <bpmn:sequenceFlow id="Flow_G_Found_M_Transit" name="Yes" sourceRef="G_Found" targetRef="M_Transit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=traceResult = "FOUND"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_M_Transit_T_Inspect" sourceRef="M_Transit" targetRef="T_Inspect" />
    <bpmn:sequenceFlow id="Flow_T_Inspect_G_Damaged" sourceRef="T_Inspect" targetRef="G_Damaged" />
    <bpmn:sequenceFlow id="Flow_G_Damaged_SP_Linehaul" name="No" sourceRef="G_Damaged" targetRef="SP_Linehaul" />
    <bpmn:sequenceFlow id="Flow_G_Damaged_M_Claim" name="Yes" sourceRef="G_Damaged" targetRef="M_Claim">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=parcelCondition = "CONTENTS_DAMAGED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Outcome_T_CountDelivery" name="Not available" sourceRef="G_Outcome" targetRef="T_CountDelivery">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=deliveryOutcome = "NOT_AVAILABLE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T_CountDelivery_G_Attempts" sourceRef="T_CountDelivery" targetRef="G_Attempts" />
    <bpmn:sequenceFlow id="Flow_SP_Linehaul_G_Intl" sourceRef="SP_Linehaul" targetRef="G_Intl" />
    <bpmn:sequenceFlow id="Flow_G_Intl_T_Customs" name="Yes" sourceRef="G_Intl" targetRef="T_Customs">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=international = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Intl_M_Customs" name="No" sourceRef="G_Intl" targetRef="M_Customs" />
    <bpmn:sequenceFlow id="Flow_T_Customs_M_Customs" sourceRef="T_Customs" targetRef="M_Customs" />
    <bpmn:sequenceFlow id="Flow_M_Customs_T_NotifyRecipient" sourceRef="M_Customs" targetRef="T_NotifyRecipient" />
    <bpmn:sequenceFlow id="Flow_B_Delay_T_DelayNotice" sourceRef="B_Delay" targetRef="T_DelayNotice" />
    <bpmn:sequenceFlow id="Flow_T_DelayNotice_E_Informed" sourceRef="T_DelayNotice" targetRef="E_Informed" />
    <bpmn:sequenceFlow id="Flow_B_Cancel_X_RefundCancel" sourceRef="B_Cancel" targetRef="X_RefundCancel" />
    <bpmn:sequenceFlow id="Flow_X_RefundCancel_M_RTS" sourceRef="X_RefundCancel" targetRef="M_RTS" />
    <bpmn:sequenceFlow id="Flow_B_NoScan_T_Trace" sourceRef="B_NoScan" targetRef="T_Trace" />
    <bpmn:sequenceFlow id="Flow_T_Trace_G_Found" sourceRef="T_Trace" targetRef="G_Found" />
    <bpmn:sequenceFlow id="Flow_G_Found_M_Claim" name="No (lost)" sourceRef="G_Found" targetRef="M_Claim" />
    <bpmn:sequenceFlow id="Flow_T_NotifyRecipient_M_Attempt" sourceRef="T_NotifyRecipient" targetRef="M_Attempt" />
    <bpmn:sequenceFlow id="Flow_C_NextDay_M_Attempt" sourceRef="C_NextDay" targetRef="M_Attempt" />
    <bpmn:sequenceFlow id="Flow_M_Attempt_T_Deliver" sourceRef="M_Attempt" targetRef="T_Deliver" />
    <bpmn:sequenceFlow id="Flow_T_Deliver_G_Outcome" sourceRef="T_Deliver" targetRef="G_Outcome" />
    <bpmn:sequenceFlow id="Flow_G_Outcome_T_Close" name="Delivered" sourceRef="G_Outcome" targetRef="T_Close">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=deliveryOutcome = "DELIVERED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Outcome_M_RTS" name="Refused / COD not paid" sourceRef="G_Outcome" targetRef="M_RTS" />
    <bpmn:sequenceFlow id="Flow_G_Outcome_M_Claim" name="Damaged" sourceRef="G_Outcome" targetRef="M_Claim">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=deliveryOutcome = "DAMAGED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Attempts_C_NextDay" name="Yes" sourceRef="G_Attempts" targetRef="C_NextDay">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=deliveryAttempts &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Attempts_M_RTS" name="No" sourceRef="G_Attempts" targetRef="M_RTS" />
    <bpmn:sequenceFlow id="Flow_T_Close_E_Delivered" sourceRef="T_Close" targetRef="E_Delivered" />
    <bpmn:sequenceFlow id="Flow_B_CustomsTimeout_M_RTS" sourceRef="B_CustomsTimeout" targetRef="M_RTS" />
    <bpmn:sequenceFlow id="Flow_M_RTS_T_Return" sourceRef="M_RTS" targetRef="T_Return" />
    <bpmn:sequenceFlow id="Flow_T_Return_E_Returned" sourceRef="T_Return" targetRef="E_Returned" />
    <bpmn:sequenceFlow id="Flow_M_Claim_T_Cover" sourceRef="M_Claim" targetRef="T_Cover" />
    <bpmn:sequenceFlow id="Flow_T_Cover_G_Covered" sourceRef="T_Cover" targetRef="G_Covered" />
    <bpmn:sequenceFlow id="Flow_G_Covered_T_Assess" name="Yes" sourceRef="G_Covered" targetRef="T_Assess">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=claimCover.covered = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Covered_T_ClaimDeclined" name="No" sourceRef="G_Covered" targetRef="T_ClaimDeclined" />
    <bpmn:sequenceFlow id="Flow_T_Assess_T_PayClaim" sourceRef="T_Assess" targetRef="T_PayClaim" />
    <bpmn:sequenceFlow id="Flow_T_PayClaim_E_ClaimSettled" sourceRef="T_PayClaim" targetRef="E_ClaimSettled" />
    <bpmn:sequenceFlow id="Flow_T_ClaimDeclined_E_ClaimDeclined" sourceRef="T_ClaimDeclined" targetRef="E_ClaimDeclined" />
    <bpmn:association id="Assoc_B_PayComp_T_Refund" associationDirection="One" sourceRef="B_PayComp" targetRef="T_Refund" />
  </bpmn:process>
  <bpmn:message id="Message_1" name="Booking request" />
  <bpmn:message id="Message_2" name="Arrival scan">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=shipmentId" />
