{
  "components": [
    {
      "type": "text",
      "id": "Field_04",
      "text": "### Collect parcel"
    },
    {
      "type": "textfield",
      "id": "Field_01",
      "key": "shipmentId",
      "label": "Shipment ID",
      "readonly": true
    },
    {
      "type": "select",
      "id": "Field_02",
      "key": "pickupOutcome",
      "label": "Outcome",
      "values": [
        {
          "label": "Collected",
          "value": "COLLECTED"
        },
        {
          "label": "Failed (absent / not ready)",
          "value": "FAILED"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "type": "textarea",
      "id": "Field_03",
      "key": "pickupNotes",
      "label": "Notes"
    }
  ],
  "type": "default",
  "id": "collect-parcel",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.8.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.28.0"
  },
  "schemaVersion": 16
}
