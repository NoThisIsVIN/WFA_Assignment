<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Defs_Loan" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.28.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:collaboration id="Collab_Defs_Loan">
    <bpmn:participant id="Pool_Bank" name="Bank" processRef="loan-origination" />
    <bpmn:participant id="Pool_Applicant" name="Applicant" />
    <bpmn:participant id="Pool_Bureau" name="Credit Bureau" />
    <bpmn:messageFlow id="Msg_Pool_Applicant_S_App" name="Application" sourceRef="Pool_Applicant" targetRef="S_App" />
    <bpmn:messageFlow id="Msg_T_ReqDocs_Pool_Applicant" name="Docs request" sourceRef="T_ReqDocs" targetRef="Pool_Applicant" />
    <bpmn:messageFlow id="Msg_Pool_Applicant_T_RecvDocs" name="Documents" sourceRef="Pool_Applicant" targetRef="T_RecvDocs" />
    <bpmn:messageFlow id="Msg_T_Score_Pool_Bureau" name="Request" sourceRef="T_Score" targetRef="Pool_Bureau" />
    <bpmn:messageFlow id="Msg_Pool_Bureau_T_Score" name="Credit score" sourceRef="Pool_Bureau" targetRef="T_Score" />
    <bpmn:messageFlow id="Msg_T_Reject_Pool_Applicant" name="Rejection" sourceRef="T_Reject" targetRef="Pool_Applicant" />
    <bpmn:messageFlow id="Msg_T_Offer_Pool_Applicant" name="Offer" sourceRef="T_Offer" targetRef="Pool_Applicant" />
    <bpmn:messageFlow id="Msg_Pool_Applicant_C_Signed" name="Signed" sourceRef="Pool_Applicant" targetRef="C_Signed" />
    <bpmn:messageFlow id="Msg_Pool_Applicant_C_Declined" name="Declined" sourceRef="Pool_Applicant" targetRef="C_Declined" />
    <bpmn:messageFlow id="Msg_T_Confirm_Pool_Applicant" name="Confirmation" sourceRef="T_Confirm" targetRef="Pool_Applicant" />
    <bpmn:messageFlow id="Msg_Pool_Applicant_W_S" name="Withdraw" sourceRef="Pool_Applicant" targetRef="W_S" />
    <bpmn:messageFlow id="Msg_W_Confirm_Pool_Applicant" name="Confirmed" sourceRef="W_Confirm" targetRef="Pool_Applicant" />
  </bpmn:collaboration>
  <bpmn:process id="loan-origination" name="Bank" isExecutable="true">
    <bpmn:laneSet id="LaneSet_loan-origination">
      <bpmn:lane id="Lane_LoanOfficer" name="Loan Officer">
        <bpmn:flowNodeRef>S_App</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ReqDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RecvDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Lapsed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EG_Offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Signed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Declined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Declined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Expired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Expired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Disbursed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES_Withdraw</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CoreBanking" name="Core Banking System">
        <bpmn:flowNodeRef>T_Elig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Elig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Score</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Bureau</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_AltBureau</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_KYC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Checks</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_FraudCompliance" name="Fraud &amp; Compliance">
        <bpmn:flowNodeRef>T_AML</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Fraud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Fraud</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Underwriter" name="Underwriter / Credit Committee">
        <bpmn:flowNodeRef>M_UW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Underwrite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_UW</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Operations" name="Operations / Disbursement">
        <bpmn:flowNodeRef>M_Disb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Disburse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Disb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_DisbCancelled</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_App" name="Application received">
      <bpmn:outgoing>Flow_S_App_M_Docs</bpmn:outgoing>
      <bpmn:messageEventDefinition id="EvDef_1" messageRef="Message_1" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="M_Docs">
      <bpmn:incoming>Flow_S_App_M_Docs</bpmn:incoming>
      <bpmn:incoming>Flow_T_RecvDocs_M_Docs</bpmn:incoming>
      <bpmn:outgoing>Flow_M_Docs_T_Elig</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="T_Elig" name="Check eligibility">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="loan-eligibility" resultVariable="eligibility" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_M_Docs_T_Elig</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Elig_G_Elig</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="G_Elig" name="Eligible?" default="Flow_G_Elig_M_Reject">
      <bpmn:incoming>Flow_T_Elig_G_Elig</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Elig_T_ReqDocs</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Elig_G_Split</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Elig_M_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T_ReqDocs" name="Request documents">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="request-documents" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Elig_T_ReqDocs</bpmn:incoming>
      <bpmn:outgoing>Flow_T_ReqDocs_T_RecvDocs</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="T_RecvDocs" name="Receive documents" messageRef="Message_2">
      <bpmn:incoming>Flow_T_ReqDocs_T_RecvDocs</bpmn:incoming>
      <bpmn:outgoing>Flow_T_RecvDocs_M_Docs</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="B_Docs" name="7 days" attachedToRef="T_RecvDocs">
      <bpmn:outgoing>Flow_B_Docs_E_Lapsed</bpmn:outgoing>
      <bpmn:timerEventDefinition id="EvDef_2">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="E_Lapsed" name="Application lapsed">
      <bpmn:incoming>Flow_B_Docs_E_Lapsed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="G_Split">
      <bpmn:incoming>Flow_G_Elig_G_Split</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Split_T_Score</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Split_T_KYC</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Split_T_AML</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_Score" name="Get credit score">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="credit-bureau" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Split_T_Score</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Score_G_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="B_Bureau" name="Bureau down" attachedToRef="T_Score">
      <bpmn:outgoing>Flow_B_Bureau_T_AltBureau</bpmn:outgoing>
      <bpmn:errorEventDefinition id="EvDef_3" errorRef="Error_1" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="T_AltBureau" name="Use backup bureau">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="backup-bureau" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_B_Bureau_T_AltBureau</bpmn:incoming>
      <bpmn:outgoing>Flow_T_AltBureau_G_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_KYC" name="Verify identity (KYC)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kyc-check" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Split_T_KYC</bpmn:incoming>
      <bpmn:outgoing>Flow_T_KYC_G_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_AML" name="AML screening">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="aml-screening" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Split_T_AML</bpmn:incoming>
      <bpmn:outgoing>Flow_T_AML_G_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="G_Join">
      <bpmn:incoming>Flow_T_Score_G_Join</bpmn:incoming>
      <bpmn:incoming>Flow_T_AltBureau_G_Join</bpmn:incoming>
      <bpmn:incoming>Flow_T_KYC_G_Join</bpmn:incoming>
      <bpmn:incoming>Flow_T_AML_G_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Join_G_Checks</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="G_Checks" name="Checks passed?" default="Flow_G_Checks_M_UW">
      <bpmn:incoming>Flow_G_Join_G_Checks</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Checks_T_Investigate</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Checks_M_UW</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Checks_M_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Investigate" name="Investigate alert">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="investigate-alert" />
        <zeebe:assignmentDefinition candidateGroups="compliance" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Checks_T_Investigate</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Investigate_G_Fraud</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Fraud" name="Fraud?" default="Flow_G_Fraud_M_UW">
      <bpmn:incoming>Flow_T_Investigate_G_Fraud</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Fraud_E_Fraud</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Fraud_M_UW</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_Fraud" name="Rejected - fraud">
      <bpmn:incoming>Flow_G_Fraud_E_Fraud</bpmn:incoming>
      <bpmn:terminateEventDefinition id="EvDef_4" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="M_UW">
      <bpmn:incoming>Flow_G_Checks_M_UW</bpmn:incoming>
      <bpmn:incoming>Flow_G_Fraud_M_UW</bpmn:incoming>
      <bpmn:outgoing>Flow_M_UW_T_Underwrite</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Underwrite" name="Underwrite application">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="underwrite-application" />
        <zeebe:assignmentDefinition candidateGroups="underwriters" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_M_UW_T_Underwrite</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Underwrite_G_UW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_UW" name="Approved?" default="Flow_G_UW_M_Reject">
      <bpmn:incoming>Flow_T_Underwrite_G_UW</bpmn:incoming>
      <bpmn:outgoing>Flow_G_UW_M_Reject</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_UW_T_Offer</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="M_Reject">
      <bpmn:incoming>Flow_G_Elig_M_Reject</bpmn:incoming>
      <bpmn:incoming>Flow_G_Checks_M_Reject</bpmn:incoming>
      <bpmn:incoming>Flow_G_UW_M_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_M_Reject_T_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T_Reject" name="Send rejection">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-rejection" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_M_Reject_T_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Reject_E_Rejected</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E_Rejected" name="Application rejected">
      <bpmn:incoming>Flow_T_Reject_E_Rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="T_Offer" name="Send offer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-offer" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_G_UW_T_Offer</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Offer_EG_Offer</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="EG_Offer">
      <bpmn:incoming>Flow_T_Offer_EG_Offer</bpmn:incoming>
      <bpmn:outgoing>Flow_EG_Offer_C_Signed</bpmn:outgoing>
      <bpmn:outgoing>Flow_EG_Offer_C_Declined</bpmn:outgoing>
      <bpmn:outgoing>Flow_EG_Offer_C_Expired</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="C_Signed" name="Signed agreement received">
      <bpmn:incoming>Flow_EG_Offer_C_Signed</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Signed_M_Disb</bpmn:outgoing>
      <bpmn:messageEventDefinition id="EvDef_5" messageRef="Message_3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="C_Declined" name="Offer declined">
      <bpmn:incoming>Flow_EG_Offer_C_Declined</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Declined_E_Declined</bpmn:outgoing>
      <bpmn:messageEventDefinition id="EvDef_6" messageRef="Message_4" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="E_Declined" name="Offer declined">
      <bpmn:incoming>Flow_C_Declined_E_Declined</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="C_Expired" name="15 days">
      <bpmn:incoming>Flow_EG_Offer_C_Expired</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Expired_E_Expired</bpmn:outgoing>
      <bpmn:timerEventDefinition id="EvDef_7">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P15D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="E_Expired" name="Offer expired">
      <bpmn:incoming>Flow_C_Expired_E_Expired</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="M_Disb">
      <bpmn:incoming>Flow_C_Signed_M_Disb</bpmn:incoming>
      <bpmn:incoming>Flow_G_Retry_M_Disb</bpmn:incoming>
      <bpmn:outgoing>Flow_M_Disb_T_Disburse</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Disburse" name="Disburse funds">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="disburse-funds" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_M_Disb_T_Disburse</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Disburse_T_Confirm</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="B_Disb" name="Payment failed" attachedToRef="T_Disburse">
      <bpmn:outgoing>Flow_B_Disb_T_Fix</bpmn:outgoing>
      <bpmn:errorEventDefinition id="EvDef_8" errorRef="Error_2" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="T_Fix" name="Fix bank details">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="fix-disbursement" />
        <zeebe:assignmentDefinition candidateGroups="operations" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_B_Disb_T_Fix</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Fix_G_Retry</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Retry" name="Retry?" default="Flow_G_Retry_E_DisbCancelled">
      <bpmn:incoming>Flow_T_Fix_G_Retry</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Retry_M_Disb</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Retry_E_DisbCancelled</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_DisbCancelled" name="Loan cancelled">
      <bpmn:incoming>Flow_G_Retry_E_DisbCancelled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="T_Confirm" name="Send confirmation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-confirmation" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_T_Disburse_T_Confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Confirm_E_Disbursed</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E_Disbursed" name="Loan disbursed">
      <bpmn:incoming>Flow_T_Confirm_E_Disbursed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="ES_Withdraw" name="Applicant withdraws" triggeredByEvent="true">
      <bpmn:startEvent id="W_S" name="Withdrawal request">
        <bpmn:outgoing>Flow_W_S_W_Confirm</bpmn:outgoing>
        <bpmn:messageEventDefinition id="EvDef_9" messageRef="Message_5" />
      </bpmn:startEvent>
      <bpmn:sendTask id="W_Confirm" name="Confirm withdrawal">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="confirm-withdrawal" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_W_S_W_Confirm</bpmn:incoming>
        <bpmn:outgoing>Flow_W_Confirm_W_E</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="W_E" name="Withdrawn">
        <bpmn:incoming>Flow_W_Confirm_W_E</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_W_S_W_Confirm" sourceRef="W_S" targetRef="W_Confirm" />
      <bpmn:sequenceFlow id="Flow_W_Confirm_W_E" sourceRef="W_Confirm" targetRef="W_E" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_S_App_M_Docs" sourceRef="S_App" targetRef="M_Docs" />
    <bpmn:sequenceFlow id="Flow_M_Docs_T_Elig" sourceRef="M_Docs" targetRef="T_Elig" />
    <bpmn:sequenceFlow id="Flow_T_Elig_G_Elig" sourceRef="T_Elig" targetRef="G_Elig" />
    <bpmn:sequenceFlow id="Flow_G_Elig_T_ReqDocs" name="Docs missing" sourceRef="G_Elig" targetRef="T_ReqDocs">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=eligibility = "INCOMPLETE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T_ReqDocs_T_RecvDocs" sourceRef="T_ReqDocs" targetRef="T_RecvDocs" />
    <bpmn:sequenceFlow id="Flow_T_RecvDocs_M_Docs" sourceRef="T_RecvDocs" targetRef="M_Docs" />
    <bpmn:sequenceFlow id="Flow_B_Docs_E_Lapsed" sourceRef="B_Docs" targetRef="E_Lapsed" />
    <bpmn:sequenceFlow id="Flow_G_Elig_G_Split" name="Yes" sourceRef="G_Elig" targetRef="G_Split">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=eligibility = "OK"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Split_T_Score" sourceRef="G_Split" targetRef="T_Score" />
    <bpmn:sequenceFlow id="Flow_G_Split_T_KYC" sourceRef="G_Split" targetRef="T_KYC" />
    <bpmn:sequenceFlow id="Flow_G_Split_T_AML" sourceRef="G_Split" targetRef="T_AML" />
    <bpmn:sequenceFlow id="Flow_T_Score_G_Join" sourceRef="T_Score" targetRef="G_Join" />
